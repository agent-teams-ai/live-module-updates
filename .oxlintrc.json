{
  "extends": [
    "./node_modules/stack-toolchain/presets/oxlint/type-aware.json",
    "./node_modules/stack-toolchain/presets/oxlint/maintainability.json"
  ],
  "options": {
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": [
        "src/features/update-operation/application/ports/**/*.ts",
        "src/features/update-operation/application/models.ts",
        "src/features/update-operation/composition/create-update-runtime.ts"
      ],
      "rules": {
        "typescript/method-signature-style": ["error", "property"]
      }
    }
  ]
}
