  },
  "productionRoots": [
    "src"
  ],
  "applicationRoots": [],
  "excludedRoots": [
    "architecture",
    "docs",
    "research",
    "scripts",
    "tests/qualification",
    "dist"
  ],
  "modules": [
    {
      "id": "live-module-updates",
      "role": "platform-library",
      "root": ".",
      "sourceRoot": "src",
      "testRoots": [
        "tests/features",
        "tests/module"
      ],
      "featuresRoot": "src/features",
      "moduleComposition": [
        "src/index.ts",
        "src/resources.ts",
        "src/testing.ts"
      ],
      "features": [
        {
          "id": "update-operation",
          "root": "src/features/update-operation",
          "layers": [
            {
              "role": "application",
              "root": "src/features/update-operation/application"
            },
            {
              "role": "adapters",
              "root": "src/features/update-operation/adapters"
            },
            {
              "role": "composition",
              "root": "src/features/update-operation/composition"
            },
            {
              "role": "testing",
              "root": "src/features/update-operation/testing"
            }
          ]
        }
      ],
      "surfaces": {
        "public": [
          "src/features/update-operation/adapters/resources.ts",
          "src/features/update-operation/application/models.ts",
          "src/features/update-operation/application/ports/adoption.ts",
          "src/features/update-operation/application/ports/authority.ts",
          "src/features/update-operation/application/ports/invocation.ts",
          "src/features/update-operation/application/ports/lifetime.ts",
          "src/features/update-operation/application/ports/preparation.ts",
          "src/features/update-operation/testing/authority-contract.ts",
          "src/features/update-operation/testing/authority-evidence.ts"
        ],
        "compositionSurface": [
          "src/features/update-operation/composition/create-update-runtime.ts"
        ],
        "testing": [
          "src/features/update-operation/testing/authority-contract.ts",
          "src/features/update-operation/testing/authority-evidence.ts"
        ]
      },
      "useEdges": [],
      "republications": [],
      "ownershipExceptions": []
    }
  ],
  "topology": {
    "sourcePolicy": "architecture/foundation/source-dependencies.yaml"
  },
  "extensions": [
    {
      "id": "portable-root-and-optional-native-cleanup",
      "authority": "docs/architecture/source-ownership.md",
      "rule": "The ordinary root has no mandatory GM or organization runtime dependency; concrete resource integration remains in its feature-owned optional adapter."
    }
  ],
  "deviations": [],
  "architectureDocument": "docs/architecture/source-ownership.md",
  "decisionRecords": [
    "docs/decisions/0002-production-source-adoption.md",
    "docs/decisions/0003-composed-runtime-ownership.md"
  ],
  "enforcementCommands": [
    "pnpm run quality:fms",
    "pnpm run quality:scope",
    "pnpm run typecheck",
    "pnpm run quality:typed",
    "pnpm run test",
    "pnpm run foundation:check"
  ]
