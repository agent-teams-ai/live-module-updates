{
  "schemaVersion": 1,
  "status": "adopted",
  "standard": {
    "id": "agent-teams.feature-module-standard",
    "version": "v1.1",
    "repository": "agent-teams-ai/.github",
    "path": "docs/architecture/feature-module-standard/v1.1.md",
    "commit": "89b5d7c512d9c4b5ae63709857a0d71cb2e6d178",
